---
import '../styles/global.css'
import { portalySupportUrl } from '../features/support/config'

interface Props {
  title: string
  description?: string
  fullWidth?: boolean
}

const { title, description, fullWidth = false } = Astro.props
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isDocsPage = normalizedPath.startsWith('/docs')
const isHomePage = normalizedPath === '/'
const isModelSelectionPage = normalizedPath === '/models'
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <div class="min-h-screen">
      <nav
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 bg-ink px-[clamp(1rem,4vw,4rem)] py-4 text-white"
        aria-label="主要導覽"
      >
        <a
          class="no-underline"
          href="/"
          aria-current={isHomePage ? 'page' : undefined}>Shape Shortcut</a
        >
        <div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2">
          <a
            class="no-underline"
            href="/docs/"
            aria-current={isDocsPage ? 'page' : undefined}>文件</a
          >
          <a
            class="no-underline"
            href="/models"
            aria-current={isModelSelectionPage ? 'page' : undefined}>選擇模型</a
          >
          {
            portalySupportUrl && (
              <a
                class="whitespace-nowrap rounded-full border border-white/60 px-3 py-1.5 text-sm font-semibold no-underline transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                href={portalySupportUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                支持這個專案
              </a>
            )
          }
        </div>
      </nav>
      <main
        class:list={[
          'p-[clamp(1.5rem,4vw,4rem)]',
          !fullWidth && 'mx-auto max-w-[1200px]',
        ]}
      >
        <slot />
      </main>
    </div>
  </body>
</html>
