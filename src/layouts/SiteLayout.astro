---
import "../styles/global.css"

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
const currentPath = Astro.url.pathname
const isDocsPage = currentPath.startsWith("/docs")
const isCadPage = currentPath.startsWith("/cad")
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <div class="min-h-screen">
      <nav
        class="flex items-center justify-between gap-4 bg-ink px-[clamp(1rem,4vw,4rem)] py-4 text-white"
        aria-label="主要導覽"
      >
        <a class="no-underline" href="/">replicad-web-cad</a>
        <div class="flex gap-4">
          <a
            class="no-underline"
            href="/docs/"
            aria-current={isDocsPage ? "page" : undefined}>文件</a
          >
          <a
            class="no-underline"
            href="/cad/"
            aria-current={isCadPage ? "page" : undefined}>CAD workspace</a
          >
        </div>
      </nav>
      <main class="mx-auto max-w-[1200px] p-[clamp(1.5rem,4vw,4rem)]">
        <slot />
      </main>
    </div>
  </body>
</html>
