---
const targetPath = '/zh-Hant/'
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
    <link rel="canonical" href={targetPath} />
    <title>Shape Shortcut</title>
    <script is:inline>
      window.location.replace('/zh-Hant/' + window.location.search)
    </script>
  </head>
  <body>
    <main>
      <p><a href={targetPath}>Shape Shortcut</a></p>
    </main>
  </body>
</html>
