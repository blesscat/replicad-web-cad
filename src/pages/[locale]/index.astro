---
import SiteLayout from '../../layouts/SiteLayout.astro'
import '../../styles/starwind.css'
import { Badge } from '../../components/starwind/badge'
import { Button } from '../../components/starwind/button'
import { Card } from '../../components/starwind/card'
import { supportProviders } from '../../features/support/config'
import { SUPPORTED_LOCALES, isLocale, translate, type Locale } from '../../i18n'
import { localizedCadPathFor, publicPathFor } from '../../i18n/routes'

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}

const locale = Astro.props.locale as Locale
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)
const t = (key: string) => translate(locale, key)
const deskBoardPath = localizedCadPathFor(locale, 'opengrid', 'desk')
const wallBoardPath = localizedCadPathFor(locale, 'opengrid', 'wall')
const modelsPath = publicPathFor(locale, 'models')
const docsPath = publicPathFor(locale, 'docs')
const aboutPath = publicPathFor(locale, 'about')
const deskFlowPath = `/docs/desk-system/desk-system-flow.${locale}.svg`

const inlineLinkClass =
  'font-semibold text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:ring-3 focus-visible:ring-outline/50'
---

<SiteLayout
  {locale}
  title={t('home.metaTitle')}
  description={t('home.description')}
>
  <div class="grid gap-16">
    <section
      class="grid items-center gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-12"
      aria-labelledby="home-title"
      data-testid="home-hero"
    >
      <div class="grid gap-5">
        <Badge variant="primary" size="sm" class="w-fit font-semibold">
          {t('home.eyebrow')}
        </Badge>
        <h1
          class="m-0 max-w-2xl text-4xl font-semibold leading-tight sm:text-5xl"
          id="home-title"
        >
          {t('home.title')}
        </h1>
        <p class="m-0 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          {t('home.description')}
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button
            as="a"
            href={modelsPath}
            variant="primary"
            size="lg"
            class="w-full no-underline sm:w-auto"
          >
            {t('home.primaryCta')}
          </Button>
          <Button
            as="a"
            href={deskBoardPath}
            variant="outline"
            size="lg"
            class="w-full no-underline sm:w-auto"
          >
            {t('home.secondaryCta')}
          </Button>
        </div>
        <p class="m-0 text-sm leading-normal text-muted-foreground">
          <a class={inlineLinkClass} href={docsPath}>{t('home.docsCta')}</a>
          <span aria-hidden="true"> · </span>{t('home.heroNote')}
        </p>
      </div>

      <figure class="m-0 grid gap-3" data-testid="home-hero-visual">
        <div
          class="grid gap-3 sm:grid-cols-[minmax(0,1.35fr)_minmax(8rem,0.65fr)]"
        >
          <img
            class="aspect-[16/10] h-full w-full rounded-2xl border border-border bg-muted object-cover shadow-lg"
            src="/model-previews/opengrid-desk.png"
            width="640"
            height="400"
            loading="eager"
            alt={t('home.heroVisual.boardAlt')}
          />
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-1">
            <img
              class="aspect-[16/10] w-full rounded-xl border border-border bg-muted object-cover"
              src="/model-previews/opengrid-stackable-box-desk.png"
              width="640"
              height="400"
              loading="lazy"
              alt={t('home.heroVisual.boxAlt')}
            />
            <img
              class="aspect-[16/10] w-full rounded-xl border border-border bg-muted object-cover"
              src="/model-previews/opengrid-stackable-cylinder-desk.png"
              width="640"
              height="400"
              loading="lazy"
              alt={t('home.heroVisual.roundBoxAlt')}
            />
          </div>
        </div>
        <figcaption class="text-sm leading-normal text-muted-foreground">
          {t('home.heroVisual.caption')}
        </figcaption>
      </figure>
    </section>

    <section
      class="grid gap-6 border-y border-border py-8"
      aria-labelledby="home-capabilities-title"
      data-testid="home-capabilities"
    >
      <header class="grid gap-2">
        <p
          class="m-0 text-sm font-semibold uppercase tracking-[0.12em] text-muted-foreground"
        >
          {t('home.features')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-capabilities-title"
        >
          {t('home.capabilities.title')}
        </h2>
      </header>
      <div
        class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"
        aria-label={t('home.features')}
      >
        <Card as="article" size="sm" class="grid gap-2 p-4 shadow-sm">
          <h3 class="m-0 text-lg font-semibold leading-tight">
            {t('home.feature.browser.title')}
          </h3>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('home.feature.browser.description')}
          </p>
        </Card>
        <Card as="article" size="sm" class="grid gap-2 p-4 shadow-sm">
          <h3 class="m-0 text-lg font-semibold leading-tight">
            {t('home.feature.parameters.title')}
          </h3>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('home.feature.parameters.description')}
          </p>
        </Card>
        <Card as="article" size="sm" class="grid gap-2 p-4 shadow-sm">
          <h3 class="m-0 text-lg font-semibold leading-tight">
            {t('home.feature.preview.title')}
          </h3>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('home.feature.preview.description')}
          </p>
        </Card>
        <Card as="article" size="sm" class="grid gap-2 p-4 shadow-sm">
          <h3 class="m-0 text-lg font-semibold leading-tight">
            {t('home.feature.export.title')}
          </h3>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('home.feature.export.description')}
          </p>
        </Card>
      </div>
    </section>

    <Card
      as="section"
      class="grid gap-8 p-5 shadow-lg sm:p-8"
      aria-labelledby="home-desk-title"
      data-testid="home-desk-system"
    >
      <header class="grid gap-3">
        <p
          class="m-0 text-sm font-semibold uppercase tracking-[0.12em] text-primary"
        >
          {t('home.desk.eyebrow')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-desk-title"
        >
          {t('home.desk.title')}
        </h2>
        <p class="m-0 max-w-3xl leading-relaxed text-muted-foreground">
          {t('home.desk.description')}
        </p>
      </header>

      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] lg:items-start"
      >
        <figure class="m-0 grid gap-3">
          <img
            class="w-full rounded-xl border border-border bg-muted"
            src={deskFlowPath}
            width="1400"
            height="820"
            loading="lazy"
            alt={t('home.desk.flowAlt')}
          />
          <figcaption class="text-sm leading-normal text-muted-foreground">
            {t('home.desk.flowCaption')}
          </figcaption>
        </figure>

        <div class="grid gap-5">
          <ol class="m-0 grid gap-4 p-0">
            <li class="flex gap-3">
              <span
                class="grid size-8 shrink-0 place-items-center rounded-full bg-primary font-semibold text-white"
                >1</span
              >
              <div class="grid gap-1">
                <h3 class="m-0 font-semibold">
                  {t('home.desk.step.board.title')}
                </h3>
                <p class="m-0 text-sm leading-normal text-muted-foreground">
                  {t('home.desk.step.board.description')}
                </p>
              </div>
            </li>
            <li class="flex gap-3">
              <span
                class="grid size-8 shrink-0 place-items-center rounded-full bg-[#0d9488] font-semibold text-white"
                >2</span
              >
              <div class="grid gap-1">
                <h3 class="m-0 font-semibold">
                  {t('home.desk.step.snap.title')}
                </h3>
                <p class="m-0 text-sm leading-normal text-muted-foreground">
                  {t('home.desk.step.snap.description')}
                </p>
              </div>
            </li>
            <li class="flex gap-3">
              <span
                class="grid size-8 shrink-0 place-items-center rounded-full bg-[#f59e0b] font-semibold text-white"
                >3</span
              >
              <div class="grid gap-1">
                <h3 class="m-0 font-semibold">
                  {t('home.desk.step.locating.title')}
                </h3>
                <p class="m-0 text-sm leading-normal text-muted-foreground">
                  {t('home.desk.step.locating.description')}
                </p>
              </div>
            </li>
            <li class="flex gap-3">
              <span
                class="grid size-8 shrink-0 place-items-center rounded-full bg-[#7c3aed] font-semibold text-white"
                >4</span
              >
              <div class="grid gap-1">
                <h3 class="m-0 font-semibold">
                  {t('home.desk.step.container.title')}
                </h3>
                <p class="m-0 text-sm leading-normal text-muted-foreground">
                  {t('home.desk.step.container.description')}
                </p>
              </div>
            </li>
          </ol>
          <Button
            as="a"
            href={docsPath}
            variant="outline"
            class="justify-self-start no-underline"
            >{t('home.desk.docsCta')}</Button
          >
        </div>
      </div>
    </Card>

    <section
      class="grid gap-6"
      aria-labelledby="home-explore-title"
      data-testid="home-explore"
    >
      <header class="grid gap-2">
        <p
          class="m-0 text-sm font-semibold uppercase tracking-[0.12em] text-muted-foreground"
        >
          {t('home.explore.eyebrow')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-explore-title"
        >
          {t('home.explore.title')}
        </h2>
      </header>
      <div class="grid gap-6 md:grid-cols-2">
        <Card
          as="article"
          class="grid gap-4 p-4 shadow-sm sm:grid-cols-[minmax(9rem,0.85fr)_minmax(0,1.15fr)] sm:items-center lg:grid-cols-1"
        >
          <img
            class="aspect-[16/10] w-full rounded-xl border border-border bg-muted object-cover"
            src="/model-previews/opengrid-desk.png"
            width="640"
            height="400"
            loading="lazy"
            alt={t('home.explore.desk.alt')}
          />
          <div class="grid gap-2">
            <h3 class="m-0 text-xl font-semibold leading-tight">
              {t('home.explore.desk.title')}
            </h3>
            <p class="m-0 text-sm leading-normal text-muted-foreground">
              {t('home.explore.desk.description')}
            </p>
            <a class={inlineLinkClass} href={deskBoardPath}
              >{t('home.explore.desk.cta')}</a
            >
          </div>
        </Card>
        <Card
          as="article"
          class="grid gap-4 p-4 shadow-sm sm:grid-cols-[minmax(9rem,0.85fr)_minmax(0,1.15fr)] sm:items-center lg:grid-cols-1"
        >
          <img
            class="aspect-[16/10] w-full rounded-xl border border-border bg-muted object-cover"
            src="/model-previews/opengrid-wall.png"
            width="640"
            height="400"
            loading="lazy"
            alt={t('home.explore.wall.alt')}
          />
          <div class="grid gap-2">
            <h3 class="m-0 text-xl font-semibold leading-tight">
              {t('home.explore.wall.title')}
            </h3>
            <p class="m-0 text-sm leading-normal text-muted-foreground">
              {t('home.explore.wall.description')}
            </p>
            <a class={inlineLinkClass} href={wallBoardPath}
              >{t('home.explore.wall.cta')}</a
            >
          </div>
        </Card>
      </div>
    </section>

    <Card
      as="section"
      class="grid gap-6 p-5 shadow-lg sm:grid-cols-[auto_minmax(0,1fr)] sm:items-center sm:p-8"
      aria-labelledby="home-maker-title"
      data-testid="home-maker"
    >
      <img
        class="mx-auto aspect-square w-24 rounded-2xl border border-border bg-muted object-cover sm:mx-0 sm:w-28"
        src="/about/blesscat.png"
        width="640"
        height="640"
        loading="lazy"
        alt={t('home.maker.portraitAlt')}
      />
      <div class="grid gap-4">
        <p
          class="m-0 text-sm font-semibold uppercase tracking-[0.12em] text-primary"
        >
          {t('home.maker.eyebrow')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-maker-title"
        >
          {t('home.maker.title')}
        </h2>
        <p class="m-0 leading-relaxed text-muted-foreground">
          {t('home.maker.body')}
        </p>
        <p class="m-0 text-sm font-semibold text-foreground">
          {t('home.maker.status')}
        </p>
        <div class="flex flex-wrap gap-x-4 gap-y-3">
          <a class={inlineLinkClass} href={aboutPath}
            >{t('home.maker.aboutCta')}</a
          >
          <a
            class={inlineLinkClass}
            href="https://github.com/blesscat"
            target="_blank"
            rel="noopener noreferrer">{t('home.maker.githubCta')}</a
          >
          <a class={inlineLinkClass} href="mailto:blesscat@gmail.com"
            >{t('home.maker.emailCta')}</a
          >
          {
            supportProviders.length > 0 && (
              <Button
                type="button"
                variant="ghost"
                size="sm"
                class={`${inlineLinkClass} h-auto rounded-none px-0 py-0 text-left hover:bg-transparent`}
                data-support-dialog-open
                data-testid="home-maker-support-trigger"
                aria-controls="support-dialog"
                aria-haspopup="dialog"
              >
                {t('home.maker.supportCta')}
              </Button>
            )
          }
        </div>
      </div>
    </Card>

    <Card
      as="section"
      class="grid gap-4 bg-banner p-6 text-banner-foreground shadow-lg ring-0 sm:p-8"
      aria-labelledby="home-final-title"
    >
      <h2
        class="m-0 text-3xl font-semibold leading-tight"
        id="home-final-title"
      >
        {t('home.final.title')}
      </h2>
      <p class="m-0 max-w-2xl leading-relaxed text-white/90">
        {t('home.final.description')}
      </p>
      <p class="m-0">
        <Button
          as="a"
          href={modelsPath}
          variant="outline"
          size="lg"
          class="border-transparent bg-nav-foreground text-nav hover:bg-nav-foreground hover:text-nav no-underline hover:brightness-95 focus-visible:ring-white dark:border-transparent dark:bg-nav-foreground dark:hover:bg-nav-foreground"
        >
          {t('home.final.cta')}
        </Button>
      </p>
    </Card>
  </div>
</SiteLayout>
