---
import { translate } from '../i18n'
const targetPath = '/zh-Hant/models'
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
    <link rel="canonical" href={targetPath} />
    <title>{translate('zh-Hant', 'models.title')} | Shape Shortcut</title>
    <script is:inline>
      window.location.replace('/zh-Hant/models' + window.location.search)
    </script>
  </head>
  <body>
    <main>
      <h1>{translate('zh-Hant', 'models.title')}</h1>
      <a href={targetPath}>{translate('zh-Hant', 'common.backToModels')}</a>
    </main>
  </body>
</html>
