---
import { modelDefinitions } from '../../features/cad/model-catalog'
import type { ModelId } from '../../cad-contract/units'
import { translate } from '../../i18n'

interface Props {
  modelId: ModelId
}

export function getStaticPaths() {
  return modelDefinitions.map((definition) => ({
    params: { modelId: definition.id },
    props: { modelId: definition.id },
  }))
}

const { modelId } = Astro.props as Props
const targetPath = `/zh-Hant/cad/${modelId}`
const modelDefinition = modelDefinitions.find(
  (definition) => definition.id === modelId,
)
const legacyTitle = modelDefinition
  ? translate('zh-Hant', modelDefinition.displayName)
  : translate('zh-Hant', 'cad.selectModel.title')
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
    <link rel="canonical" href={targetPath} />
    <title>{legacyTitle} | Shape Shortcut</title>
    <script is:inline define:vars={{ targetPath }}>
      window.location.replace(targetPath + window.location.search)
    </script>
  </head>
  <body>
    <main>
      <p>
        <a href={targetPath}>{translate('zh-Hant', 'common.backToModels')}</a>
      </p>
    </main>
  </body>
</html>
