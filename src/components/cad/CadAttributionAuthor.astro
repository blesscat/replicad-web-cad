---
interface Props {
  label: string
  role: string
  url?: string
}

const { label, role, url } = Astro.props
---

<span class="inline-flex items-baseline gap-1">
  {
    url ? (
      <a href={url} target="_blank" rel="noopener noreferrer">
        {label}
      </a>
    ) : (
      <span>{label}</span>
    )
  }
  <span class="text-muted">({role})</span>
</span>
