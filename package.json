{
  "name": "replicad-web-cad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{astro,css,scss,ts,tsx,js,jsx,mjs,cjs,json}\" \"tests/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"*.{mjs,cjs,js,jsx,ts,tsx,json,yaml,yml,md}\" \".vscode/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{astro,css,scss,ts,tsx,js,jsx,mjs,cjs,json}\" \"tests/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"*.{mjs,cjs,js,jsx,ts,tsx,json,yaml,yml,md}\" \".vscode/**/*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "xvfb-run -a env PW_HEADFUL=1 playwright test --project=firefox --headed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "astro": "^7.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
